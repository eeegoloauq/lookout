# Secrets for lookout. Copy to /etc/lookout/lookout.env and chmod 0600.
# Never put these in the YAML config.

LOOKOUT_TELEGRAM_TOKEN=
LOOKOUT_TELEGRAM_CHAT_ID=

# Optional, only if a check header uses ${LOOKOUT_BASIC_AUTH}:
# LOOKOUT_BASIC_AUTH=

# One per push check, matching its token: ${LOOKOUT_PUSH_TOKEN_ZFS}. The same
# value goes in the ping URL the job calls, so it is a password on both ends:
#   LOOKOUT_PUSH_TOKEN_ZFS=$(head -c 24 /dev/urandom | base64 | tr -d '+/=')
# LOOKOUT_PUSH_TOKEN_ZFS=
